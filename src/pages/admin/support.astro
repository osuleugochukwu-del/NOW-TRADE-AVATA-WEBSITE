---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Support Inbox — Trade Avata" description="Trade Avata support inbox.">
  <main class="support-admin"><div class="support-admin__head"><div><span class="eyebrow">ADMIN</span><h1>Support Inbox</h1><p>Review visitor conversations, reply, resolve and audit every response.</p></div><a href="../">Admin dashboard</a></div>
  <div class="support-admin__grid"><aside class="support-list" data-list><div class="empty">Loading conversations…</div></aside><section class="support-thread"><div class="thread-head"><strong data-title>Select a conversation</strong><span data-status></span></div><div class="thread-messages" data-messages><div class="empty">Choose a conversation.</div></div><form data-form class="reply-form"><input name="message" maxlength="2000" placeholder="Reply to visitor…" required /><button>Send</button><button type="button" data-resolve>Resolve</button></form></section></div></main>
  <script>
  import { watchAuth } from '../../lib/firebase/auth.js'; import { getAdminRole, writeAdminAudit } from '../../lib/firebase/admin.js'; import { listSupportConversations, markSupportRead, resolveSupportConversation, sendSupportMessage, watchSupportMessages } from '../../lib/firebase/support.js';
  let user=null, current=null, stop=null; const list=document.querySelector('[data-list]'), msgs=document.querySelector('[data-messages]'), form=document.querySelector('[data-form]'), title=document.querySelector('[data-title]'), status=document.querySelector('[data-status]');
  const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c])); const fmt=v=>v?.toDate?v.toDate().toLocaleString():'';
  function renderMessages(items){msgs.innerHTML=items.map(m=>`<div class="msg ${m.senderType==='admin'?'admin':'visitor'}"><span>${m.senderType==='admin'?'Admin':'Visitor'}</span><p>${esc(m.message)}</p><small>${fmt(m.createdAt)}</small></div>`).join('')||'<div class="empty">No messages.</div>';msgs.scrollTop=msgs.scrollHeight;}
  async function load(){const data=await listSupportConversations();list.innerHTML=data.map(x=>`<button class="conv ${x.unreadForAdmin?'unread':''}" data-id="${x.id}"><strong>${x.unreadForAdmin?'● ':''}Visitor ${esc(x.visitorUid.slice(0,8))}</strong><span>${esc(x.lastMessage||'')}</span><small>${fmt(x.lastMessageAt)}</small></button>`).join('')||'<div class="empty">No support conversations yet.</div>';list.querySelectorAll('[data-id]').forEach(b=>b.addEventListener('click',()=>open(data.find(x=>x.id===b.dataset.id))));}
  async function open(c){current=c;title.textContent=`Visitor ${c.visitorUid.slice(0,8)}`;status.textContent=c.status||'open';await markSupportRead(c.id);if(stop)stop();stop=watchSupportMessages(c.id,renderMessages);}
  form.addEventListener('submit',async e=>{e.preventDefault();if(!current)return;const input=form.message;const message=input.value.trim();if(!message)return;input.value='';await sendSupportMessage(current.id,'admin',user.uid,message);await writeAdminAudit({actorId:user.uid,action:'reply',target:'supportConversation',targetId:current.id});await load();});
  document.querySelector('[data-resolve]').addEventListener('click',async()=>{if(!current)return;await resolveSupportConversation(current.id,user.uid);await writeAdminAudit({actorId:user.uid,action:'resolve',target:'supportConversation',targetId:current.id});await load();open({...current,status:'resolved'});});
  watchAuth(async u=>{if(!u){title.textContent='Sign in required';return;}user=u;const role=await getAdminRole(u.uid);if(!role){title.textContent='Administrator access required';return;}await load();});
  </script>
  <style>
  .support-admin{max-width:1180px;margin:0 auto;padding:48px 20px}.support-admin__head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:22px}.support-admin__head a{padding:10px 14px;border:1px solid #35516e;border-radius:10px}.support-admin__grid{display:grid;grid-template-columns:340px 1fr;min-height:620px;border:1px solid #29445f;border-radius:18px;overflow:hidden;background:#071426}.support-list{border-right:1px solid #29445f;overflow:auto}.conv{width:100%;text-align:left;border:0;border-bottom:1px solid #1d344a;background:transparent;color:#edf6ff;padding:14px;cursor:pointer}.conv:hover,.conv.unread{background:#0c1f34}.conv span,.conv small{display:block;color:#8ea6bc;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:5px}.conv.unread strong{color:#5ca5ff}.thread-head{padding:16px;border-bottom:1px solid #29445f;display:flex;justify-content:space-between}.thread-messages{padding:18px;overflow:auto;display:flex;flex-direction:column;gap:10px;min-height:500px;max-height:560px}.msg{max-width:78%;padding:10px 12px;border-radius:12px;background:#10253d}.msg.visitor{align-self:flex-start}.msg.admin{align-self:flex-end;background:#0b73ff}.msg span,.msg small{font-size:11px;opacity:.7}.msg p{margin:4px 0;white-space:pre-wrap}.reply-form{display:flex;gap:8px;padding:12px;border-top:1px solid #29445f}.reply-form input{flex:1;min-width:0;padding:11px;border-radius:10px;border:1px solid #35516e;background:#091b2e;color:#fff}.reply-form button{border:0;border-radius:10px;padding:0 14px;background:#0b73ff;color:#fff;font-weight:700}.reply-form button[data-resolve]{background:#183653}.empty{padding:24px;color:#8ea6bc}@media(max-width:760px){.support-admin__grid{grid-template-columns:1fr}.support-list{max-height:280px;border-right:0;border-bottom:1px solid #29445f}.support-admin__head{align-items:start;flex-direction:column}}
  </style>
</BaseLayout>
