<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Copy Trading Manager</title></head><body><main><header><span>TRADE AVATA ADMIN</span><h1>Copy Trading Manager</h1><p>Control private testing, public visibility and execution independently.</p></header><section class="controls"><label>Private module <input type="checkbox" data-field="private" checked></label><label>Public visibility <input type="checkbox" data-field="publicVisible"></label><label>Master registration <input type="checkbox" data-field="masterRegistration"></label><label>Copier registration <input type="checkbox" data-field="copierRegistration"></label><label>Test execution <input type="checkbox" data-field="testExecution"></label><label>Live execution <input type="checkbox" data-field="liveExecution"></label><label>Module maintenance <input type="checkbox" data-field="maintenance"></label></section><button id="save">Save Copy Trading controls</button><p id="status"></p><section><h2>Operational areas</h2><div class="grid"><article>Providers / Masters</article><article>Copiers</article><article>Relationships</article><article>Execution instructions</article><article>Billing</article><article>Audit trail</article></div></section></main><script type="module">
import {doc,getDoc,setDoc,getFirestore,serverTimestamp} from 'firebase/firestore';import {firebaseApp} from '../../lib/firebase/config.js';import {getAuth} from 'firebase/auth';
const db=firebaseApp?getFirestore(firebaseApp):null;const auth=firebaseApp?getAuth(firebaseApp):null;const fields=[...document.querySelectorAll('[data-field]')];
async function load(){if(!db)return;const s=await getDoc(doc(db,'siteSettings','copyTrading'));if(s.exists())fields.forEach(x=>x.checked=Boolean(s.data()[x.dataset.field]));}
document.querySelector('#save').onclick=async()=>{if(!db||!auth?.currentUser){status.textContent='Sign in with an authorized admin account first.';return;}const values=Object.fromEntries(fields.map(x=>[x.dataset.field,x.checked]));await setDoc(doc(db,'siteSettings','copyTrading'),{...values,updatedAt:serverTimestamp()},{merge:true});status.textContent='Saved.'};load().catch(()=>status.textContent='Unable to load settings.');
</script><style>body{margin:0;background:#070b12;color:#edf3fb;font:15px system-ui}main{max-width:1000px;margin:auto;padding:35px}header{border-bottom:1px solid #1c2735;padding-bottom:25px}header span{color:#64d7ff;letter-spacing:.12em;font-size:11px}.controls,.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin:25px 0}.controls label,article{padding:18px;border:1px solid #1c2735;border-radius:14px;background:#0d131d}.controls input{float:right}button{padding:12px 16px;border:0;border-radius:10px;background:#4b8cff;color:white}.grid{grid-template-columns:repeat(3,1fr)}@media(max-width:650px){.controls,.grid{grid-template-columns:1fr}}</style></main></body></html>
