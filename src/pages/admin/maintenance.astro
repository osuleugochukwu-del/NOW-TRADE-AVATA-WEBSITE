<!doctype html><html><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Website Maintenance</title></head><body><main><span>TRADE AVATA ADMIN</span><h1>Website Maintenance Mode</h1><p>Temporarily take the public website offline while authorized administrators continue working.</p><label>Maintenance mode <input id="enabled" type="checkbox"></label><label>Title <input id="title" value="Trade Avata is under maintenance"></label><label>Message <textarea id="message">We are making improvements. Please check back soon.</textarea></label><button id="save">Save maintenance settings</button><p id="status"></p></main><script type="module">import{doc,getDoc,setDoc,getFirestore,serverTimestamp}from'firebase/firestore';import{getAuth}from'firebase/auth';import{firebaseApp}from'../../lib/firebase/config.js';const db=firebaseApp?getFirestore(firebaseApp):null,auth=firebaseApp?getAuth(firebaseApp):null,e=document.querySelector('#enabled'),t=document.querySelector('#title'),m=document.querySelector('#message'),s=document.querySelector('#status');async function load(){if(!db)return;const x=await getDoc(doc(db,'siteSettings','global'));if(x.exists()){const d=x.data();e.checked=!!d.maintenanceMode;t.value=d.maintenanceTitle||t.value;m.value=d.maintenanceMessage||m.value}}document.querySelector('#save').onclick=async()=>{if(!db||!auth?.currentUser){s.textContent='Sign in with an authorized admin account first.';return}await setDoc(doc(db,'siteSettings','global'),{maintenanceMode:e.checked,maintenanceTitle:t.value.trim(),maintenanceMessage:m.value.trim(),allowAdminAccess:true,allowTesterAccess:true,updatedAt:serverTimestamp()},{merge:true});s.textContent='Saved.'};load().catch(()=>s.textContent='Unable to load settings.');</script><style>body{margin:0;background:#070b12;color:#edf3fb;font:15px system-ui}main{max-width:760px;margin:auto;padding:50px}span{color:#64d7ff;letter-spacing:.12em;font-size:11px}label{display:grid;gap:8px;margin:16px 0;color:#9aa7ba}input,textarea{padding:12px;border:1px solid #1c2735;border-radius:10px;background:#0d131d;color:#edf3fb}textarea{min-height:120px}button{padding:12px 16px;border:0;border-radius:10px;background:#4b8cff;color:#fff}</style></main></body></html>
