---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Advertising Manager — Trade Avata" description="Enable small, controlled ad placements across Trade Avata.">
  <main class="admin-page"><header><div><span class="eyebrow">Admin</span><h1>Advertising Manager</h1><p>Ads are OFF by default. Enable only the placements you want.</p></div><a href="/admin/">Admin</a></header>
    <form id="adForm" class="card"><label>Placement<select name="placement"><option value="homepage">Homepage</option><option value="aiAnalytics">AI Analytics</option><option value="journal">Journal</option><option value="tools">Tools</option><option value="learn">Learn</option><option value="store">Store</option></select></label><label>Provider<select name="provider"><option value="adsense">Google AdSense</option><option value="custom">Custom</option></select></label><label>AdSense Publisher ID<input name="publisherId" placeholder="ca-pub-..." autocomplete="off"></label><label>Ad slot ID<input name="slotId" placeholder="1234567890" autocomplete="off"></label><div class="row"><label>Max width (px)<input name="maxWidth" type="number" value="320" min="50" max="600"></label><label>Max height (px)<input name="maxHeight" type="number" value="100" min="30" max="250"></label></div><label><input name="enabled" type="checkbox"> Enable this placement</label><button>Save ad slot</button></form><p id="status"></p><p class="note">Keep ads visually small and separate from navigation/content. AdSense controls the actual creative; this manager controls where your slot is allowed to appear.</p>
  </main>
</BaseLayout>
<script>
import { watchAuth } from '../../lib/firebase/auth.js'; import { getAdminRole, saveAdminDocument } from '../../lib/firebase/admin.js';
const form=document.querySelector('#adForm'),status=document.querySelector('#status'); let role=null;
watchAuth(async u=>{if(!u){status.textContent='Sign in required.';return;}role=await getAdminRole(u.uid);status.textContent=role?'Ready.':'Administrator access required.';});
form.addEventListener('submit',async e=>{e.preventDefault();if(!role)return;const f=new FormData(form);try{const placement=f.get('placement');await saveAdminDocument('adSlots',`slot_${placement}`,{name:`${placement} ad`,placement,provider:f.get('provider'),enabled:f.get('enabled')==='on',publisherId:f.get('publisherId')||null,slotId:f.get('slotId')||null,format:'rectangle',maxWidth:Number(f.get('maxWidth')||320),maxHeight:Number(f.get('maxHeight')||100),mobileEnabled:false,startAt:null,endAt:null});status.textContent='Saved. The slot remains off unless you enabled it.';}catch(err){status.textContent=err.message;}});
</script>
<style>.admin-page{max-width:900px;margin:0 auto;padding:52px 20px}.admin-page header{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:24px}.admin-page header a{padding:10px 14px;border:1px solid var(--line);border-radius:10px}.card{border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:20px}.card label{display:block;margin:0 0 14px;font-size:13px}.card input,.card select{display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:11px;border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:10px}.card label input[type=checkbox]{display:inline-block;width:auto;margin-right:8px}.row{display:grid;grid-template-columns:1fr 1fr;gap:14px}.card button{border:0;border-radius:10px;padding:11px 15px;background:var(--sky);color:#fff;font-weight:750;cursor:pointer}.note,#status{color:var(--muted);margin-top:16px}@media(max-width:600px){.row{grid-template-columns:1fr}.admin-page header{align-items:start;flex-direction:column}}</style>
