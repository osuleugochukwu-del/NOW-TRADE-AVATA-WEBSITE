---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Learning Manager — Trade Avata" description="Create courses, modules and written/video lessons from the Trade Avata admin area.">
  <main class="admin-page"><header><div><span class="eyebrow">Admin</span><h1>Learning Manager</h1><p>Create the written and video learning library without editing website code.</p></div><a href="/admin/">Admin</a></header>
    <section class="grid"><form id="courseForm" class="card"><h2>Course</h2><label>Course title<input name="title" required placeholder="Forex Foundations"></label><label>Slug<input name="slug" required placeholder="forex-foundations"></label><label>Description<textarea name="description" rows="4"></textarea></label><button>Create course</button></form>
    <form id="lessonForm" class="card"><h2>Lesson</h2><label>Course ID<input name="courseId" required></label><label>Module ID<input name="moduleId" required></label><label>Lesson title<input name="title" required placeholder="What is a Pip?"></label><label>Written content<textarea name="content" rows="9" placeholder="Write the full lesson here..."></textarea></label><label>Video URL<input name="videoUrl" placeholder="https://..." type="url"></label><label>Image URL<input name="imageUrl" placeholder="https://..." type="url"></label><button>Create lesson</button></form></section>
    <p id="status"></p>
  </main>
</BaseLayout>
<script>
import { watchAuth } from '../../lib/firebase/auth.js';
import { getAdminRole, saveAdminDocument, saveAdminPathDocument } from '../../lib/firebase/admin.js';
const status=document.querySelector('#status'); let role=null;
watchAuth(async u=>{if(!u){status.textContent='Sign in required.';return;} role=await getAdminRole(u.uid); if(!role){status.textContent='Administrator access required.';return;} status.textContent='Ready.';});
document.querySelector('#courseForm').addEventListener('submit',async e=>{e.preventDefault();if(!role)return;const f=new FormData(e.currentTarget);try{const id=await saveAdminDocument('courses',null,{title:f.get('title'),slug:f.get('slug'),description:f.get('description'),published:false,order:0});status.textContent=`Course created: ${id}`;e.currentTarget.reset();}catch(err){status.textContent=err.message;}});
document.querySelector('#lessonForm').addEventListener('submit',async e=>{e.preventDefault();if(!role)return;const f=new FormData(e.currentTarget);try{const content=String(f.get('content')||'');const path=`courses/${f.get('courseId')}/modules/${f.get('moduleId')}/lessons`;const id=await saveAdminPathDocument(path,null,{title:f.get('title'),slug:String(f.get('title')).toLowerCase().trim().replace(/[^a-z0-9]+/g,'-'),contentBlocks:content?[{type:'richText',text:content}]:[],videoUrl:f.get('videoUrl')||null,imageUrl:f.get('imageUrl')||null,published:false,order:0});status.textContent=`Lesson created: ${id}`;e.currentTarget.reset();}catch(err){status.textContent=err.message;}});
</script>
<style>.admin-page{max-width:1180px;margin:0 auto;padding:52px 20px}.admin-page header{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:24px}.admin-page header a{padding:10px 14px;border:1px solid var(--line);border-radius:10px}.grid{display:grid;grid-template-columns:1fr 1.4fr;gap:16px}.card{border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:20px}.card h2{margin-top:0}.card label{display:block;margin:0 0 14px;font-size:13px}.card input,.card textarea{display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:11px;border:1px solid var(--line);background:var(--bg);color:var(--text);border-radius:10px}.card button{border:0;border-radius:10px;padding:11px 15px;background:var(--sky);color:#fff;font-weight:750;cursor:pointer}#status{margin-top:16px;color:var(--muted)}@media(max-width:760px){.grid{grid-template-columns:1fr}.admin-page header{align-items:start;flex-direction:column}}</style>
