---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Email Centre — Trade Avata" description="Trade Avata email templates and campaigns.">
<main class="email-admin"><header><div><span class="eyebrow">ADMIN</span><h1>Email Centre</h1><p>Create reusable templates and send one campaign to a selected audience.</p></div><a href="../">Admin dashboard</a></header>
<section class="email-grid"><aside class="card"><div class="section-head"><h2>Templates</h2><button data-new>New</button></div><div data-templates class="templates">Loading…</div></aside><section class="card"><form data-form><input type="hidden" name="id"><label>Template name<input name="name" required></label><label>Subject<input name="subject" required></label><label>Audience<select name="audience" data-audience><option value="all">All registered users</option><option value="students">Students</option><option value="selected">Selected users</option></select></label><label data-recipient-wrap hidden>Recipient emails (comma-separated)<textarea name="recipientEmails" rows="3" placeholder="person@example.com, another@example.com"></textarea></label><label>Body<textarea name="body" rows="14" required placeholder="Write your email here…"></textarea></label><div class="actions"><button type="submit">Save template</button><button type="button" data-send>Send now</button></div></form><div data-status class="status"></div></section></section></main>
<script>
import { collection, addDoc, getDocs, query, orderBy, limit, doc, setDoc, serverTimestamp, writeBatch } from 'firebase/firestore'; import { watchAuth } from '../../lib/firebase/auth.js'; import { db } from '../../lib/firebase/db.js'; import { getAdminRole, writeAdminAudit } from '../../lib/firebase/admin.js';
let user=null, role=null, selected=null, templates=[]; const list=document.querySelector('[data-templates]'), form=document.querySelector('[data-form]'), status=document.querySelector('[data-status]'); const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
function values(){return Object.fromEntries(new FormData(form).entries())} function fill(x={}){form.reset();for(const [k,v] of Object.entries(x)){const el=form.elements[k];if(el)el.value=v??''}selected=x.id||null}
async function load(){const snap=await getDocs(query(collection(db,'emailTemplates'),orderBy('updatedAt','desc'),limit(100)));templates=snap.docs.map(d=>({id:d.id,...d.data()}));list.innerHTML=templates.map(x=>`<button data-id="${x.id}"><strong>${esc(x.name)}</strong><small>${esc(x.subject)}</small></button>`).join('')||'<p>No templates yet.</p>';list.querySelectorAll('[data-id]').forEach(b=>b.addEventListener('click',()=>fill(templates.find(x=>x.id===b.dataset.id))))}
form.addEventListener('submit',async e=>{e.preventDefault();const v=values();const id=v.id||doc(collection(db,'emailTemplates')).id;delete v.id;await setDoc(doc(db,'emailTemplates',id),{...v,updatedAt:serverTimestamp(),createdAt:serverTimestamp(),createdBy:user.uid},{merge:true});await writeAdminAudit({actorId:user.uid,action:'save',target:'emailTemplate',targetId:id});status.textContent='Template saved.';await load();fill({...v,id});});
document.querySelector('[data-new]').addEventListener('click',()=>fill());
document.querySelector('[data-send]').addEventListener('click',async()=>{const v=values();if(!v.subject||!v.body){status.textContent='Choose a complete template first.';return;} if(!confirm('Queue this email for the selected audience?'))return;const usersSnap=await getDocs(collection(db,'users'));let recipients=usersSnap.docs.map(d=>({id:d.id,...d.data()})).filter(x=>x.email);if(v.audience==='selected'){const emails=String(v.recipientEmails||'').split(',').map(x=>x.trim().toLowerCase()).filter(Boolean);recipients=recipients.filter(x=>emails.includes(String(x.email).toLowerCase()));}if(v.audience==='students'){const enrollSnap=await getDocs(collection(db,'enrollments'));const ids=new Set(enrollSnap.docs.map(d=>d.data().userId).filter(Boolean));recipients=recipients.filter(x=>ids.has(x.id));}const campaign=await addDoc(collection(db,'emailCampaigns'),{templateId:v.id||null,subject:v.subject,body:v.body,audience:v.audience,status:'queued',recipientCount:recipients.length,createdBy:user.uid,createdAt:serverTimestamp()});let batch=writeBatch(db);let count=0;for(const recipient of recipients){batch.set(doc(collection(db,'mail')),{to:recipient.email,message:{subject:v.subject,html:v.body.replace(/\n/g,'<br>')},campaignId:campaign.id,createdAt:serverTimestamp()});count++;if(count===450){await batch.commit();batch=writeBatch(db);count=0;}}if(count)await batch.commit();await writeAdminAudit({actorId:user.uid,action:'send',target:'emailCampaign',targetId:campaign.id,metadata:{recipientCount:recipients.length,audience:v.audience}});status.textContent=`Queued ${recipients.length} email(s). The Trade Avata email queue will use the server-side email provider configured for the project.`;});
document.querySelector('[data-audience]').addEventListener('change', e=>{document.querySelector('[data-recipient-wrap]').hidden=e.target.value!=='selected';});
watchAuth(async u=>{user=u;if(!u){status.textContent='Sign in required.';return;}role=await getAdminRole(u.uid);if(!role){status.textContent='Administrator access required.';return;}await load();});
</script>
<style>
.email-admin{max-width:1120px;margin:0 auto;padding:48px 20px}.email-admin header{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px}.email-admin header a{padding:10px 14px;border:1px solid #35516e;border-radius:10px}.email-grid{display:grid;grid-template-columns:330px 1fr;gap:18px}.card{background:#071426;border:1px solid #29445f;border-radius:18px;padding:18px}.section-head{display:flex;justify-content:space-between;align-items:center}.templates{display:grid;gap:6px;margin-top:12px}.templates button{text-align:left;border:1px solid transparent;background:#0b1d31;color:#edf6ff;padding:12px;border-radius:10px;cursor:pointer}.templates button:hover{border-color:#35516e}.templates small{display:block;color:#8ea6bc;margin-top:4px}.email-admin label{display:block;margin-bottom:14px}.email-admin input,.email-admin select,.email-admin textarea{display:block;width:100%;box-sizing:border-box;margin-top:6px;padding:11px;border:1px solid #35516e;background:#091b2e;color:#fff;border-radius:10px}.actions{display:flex;gap:8px}.actions button,.section-head button{border:0;border-radius:10px;padding:10px 14px;background:#0b73ff;color:#fff;font-weight:700}.status{margin-top:14px;color:#9fc2df}@media(max-width:760px){.email-grid{grid-template-columns:1fr}.email-admin header{align-items:start;flex-direction:column;gap:12px}}
</style>
</BaseLayout>
