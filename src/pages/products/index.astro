---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/site.js';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Indicators & Products — Trade Avata" description="Trade Avata indicators and digital trading products.">
<section class="section"><div class="shell"><span class="eyebrow">TRADE AVATA STORE</span><h1 class="page-title">Indicators &amp; Products</h1><p class="lead">Explore Trade Avata indicators, platforms and digital products. Availability and details are managed from the admin backend.</p><div class="grid grid-3" style="margin-top:32px">{products.filter(p=>p.visible!==false).map(p=><article class="card"><span class="eyebrow">{p.type}</span><h2>{p.name}</h2><p>{p.short}</p><p class="lead" style="font-size:13px">{p.platforms.join(' · ')}</p><a class="button button-small" href={`${base}store/`}>View in Store →</a></article>)}</div></div></section>
</BaseLayout>
