---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { socialLinks } from '../../data/site.js';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Contact — Trade Avata" description="Contact Trade Avata for product, course, account and support questions.">
  <section class="section"><div class="shell split"><div><span class="eyebrow">Contact</span><h1 class="page-title">Let’s keep your trading journey moving.</h1><p class="lead">Questions about Trade Avata, products, courses, access or support? Send a message and the appropriate team can follow up.</p></div><div class="feature-visual" aria-label="Trade Avata contact visual"></div></div></section>
  <section class="section"><div class="shell grid grid-2"><form id="contactForm" class="card"><label>Name<input name="name" autocomplete="name" maxlength="100" required></label><label>Email<input name="email" type="email" autocomplete="email" maxlength="200" required></label><label>Subject<input name="subject" maxlength="160" required></label><label>Message<textarea name="message" maxlength="4000" rows="7" required></textarea></label><input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" /><button class="button" type="submit">Send message</button><p id="contactStatus" class="lead" style="font-size:14px;margin:0"></p></form><aside class="card"><span class="eyebrow">Support</span><h2>Need account or product help?</h2><p>Registered members can use Member Support after signing in. Public visitors can use this contact form for general questions.</p><a class="button button-secondary" href={`${base}login/`}>Open Member Support</a><h3 style="margin-top:28px">Follow Trade Avata</h3><div style="display:flex;flex-wrap:wrap;gap:12px">{socialLinks.filter(link => link.enabled !== false && link.href).map(link=><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div></aside></div></section>
</BaseLayout>
<script>
import { addDoc, collection, serverTimestamp } from 'firebase/firestore';
import { db } from '../../lib/firebase/db.js';
const form=document.querySelector('#contactForm'); const status=document.querySelector('#contactStatus');
form?.addEventListener('submit',async e=>{e.preventDefault(); if(!db){status.textContent='Contact service is not configured yet.';return;} const f=new FormData(form); if(String(f.get('website')||'')){status.textContent='Message could not be submitted.';return;} const name=String(f.get('name')||'').trim(); const email=String(f.get('email')||'').trim(); const subject=String(f.get('subject')||'').trim(); const message=String(f.get('message')||'').trim(); if(!name||!email||!subject||!message){status.textContent='Please complete all fields.';return;} if(/[\r\n]/.test(email)||/[\r\n]/.test(subject)){status.textContent='Please check the submitted fields.';return;} status.textContent='Sending…'; try{await addDoc(collection(db,'contactMessages'),{name,email,subject,message,status:'new',createdAt:serverTimestamp()});form.reset();status.textContent='Message received. Trade Avata will follow up.';}catch(err){status.textContent=err?.message||'Message could not be sent. Please try again.';}});
</script>
