---
import { demoAccount, accounts, trades, monthly, symbols, strategies, sessions, weekday, equity } from '../lib/analytics/demo.js';
import { buildAIAnalyticsEvidence, getAIAnalyticsPrompt, requestAIAnalytics } from '../lib/analytics/ai.js';
import '../styles/analytics.css';

const base = import.meta.env.BASE_URL;
const json = (value) => JSON.stringify(value);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Trade Avata Analytics — account performance, risk intelligence and AI-powered trading analysis." />
  <title>Analytics | Trade Avata</title>
  <link rel="icon" type="image/png" href={`${base}brand/trade-avata-logo.svg`} />
</head>
<body class="analytics-body">
  <div class="ta-shell" id="analyticsApp">
    <aside class="ta-sidebar" id="sidebar">
      <a class="ta-brand" href={base} aria-label="Trade Avata home">
        <img src={`${base}brand/trade-avata-logo.svg`} alt="" />
        <span><b>Trade Avata</b><small>Analytics</small></span>
      </a>
      <div class="side-kicker">MY TRADING</div>
      <nav class="ta-nav" aria-label="Analytics navigation">
        {[
          ['dashboard','Dashboard','⌂'],['performance','Performance','↗'],['trades','Trades','▤'],
          ['calendar','Calendar','□'],['strategies','Strategies','◆'],['risk','Risk','△'],
          ['comparisons','Comparisons','⇄'],['bookkeeping','Bookkeeping','₦'],['insights','Insights','✦'],['ai-analytics','AI Analytics','AI'],
          ['reports','Reports','▥'],['downloads','Downloads','⇩'],['accounts','Accounts','◉']
        ].map(([id,label,icon]) => <button class="nav-link" data-view={id}><i>{icon}</i><span>{label}</span></button>)}
      </nav>
      <div class="side-bottom">
        <button class="nav-link" data-open-customize><i>⚙</i><span>Customize dashboard</span></button>
        <a class="back-site" href={base}>← Back to Trade Avata</a>
      </div>
    </aside>

    <main class="ta-main">
      <header class="ta-topbar">
        <div class="mobile-brand">
          <button class="icon-btn" id="mobileMenu" aria-label="Open navigation">☰</button>
          <a href={base}><img src={`${base}brand/trade-avata-logo.svg`} alt="" /><b>Trade Avata</b></a>
        </div>
        <div class="account-header">
          <button class="account-picker" id="accountPicker" aria-haspopup="dialog">
            <span class="status-dot"></span>
            <span class="account-picker-copy"><b id="accountName">Primary Trading Account</b><small id="accountMeta">DEMO · MetaTrader 5 · USD</small></span>
            <span class="chevron">⌄</span>
          </button>
          <span class="sync-state" id="syncState">Demo workspace</span>
        </div>
        <div class="top-actions">
          <button class="ghost-btn" id="syncBtn">↻ <span>Sync</span></button>
          <button class="primary-btn" id="connectBtn">＋ Connect Account</button>
          <button class="icon-btn" id="topMore" aria-label="More actions">⋯</button>
        </div>
      </header>

      <div class="mobile-nav-strip">
        {['dashboard','performance','trades','calendar','strategies','risk','comparisons','insights','ai-analytics','reports','downloads','accounts'].map(id => <button data-view={id}>{id === 'dashboard' ? 'Home' : id[0].toUpperCase()+id.slice(1)}</button>)}
      </div>

      <div class="ta-content">
        <!-- DASHBOARD -->
        <section class="ta-view active" data-panel="dashboard">
          <div class="page-heading">
            <div><span class="eyebrow">ANALYTICS</span><h1>Trading Dashboard</h1><p>What happened, when it happened, and where the results came from.</p></div>
            <div class="heading-actions"><button class="ghost-btn" id="customizeBtn">⚙ Customize</button><button class="period-btn" id="periodBtn">Last 90 days <span>⌄</span></button></div>
          </div>

          <div class="filter-bar" id="filterBar">
            <button class="filter-chip active">Account: <b id="filterAccount">Primary</b></button>
            <button class="filter-chip">Period: <b>Last 90 days</b></button>
            <button class="filter-chip">Symbol: <b>All</b></button>
            <button class="filter-chip">Direction: <b>All</b></button>
            <button class="filter-chip">Strategy: <b>All</b></button>
            <button class="filter-chip">Session: <b>All</b></button>
            <button class="filter-chip">Result: <b>All</b></button>
            <button class="filter-more" id="filterMore">＋ More filters</button>
          </div>

          <div class="dashboard-canvas" id="dashboardCanvas">
          <div class="kpi-strip" data-widget="kpis">
            <article class="kpi-card"><span>Equity</span><strong id="kpiEquity">$12,846.20</strong><em class="positive">+4.82% vs prior period</em></article>
            <article class="kpi-card"><span>Net P&amp;L</span><strong id="kpiPnl">+$2,846.20</strong><em class="positive">+28.46% return</em></article>
            <article class="kpi-card"><span>Win Rate</span><strong id="kpiWin">64.2%</strong><em>206 wins · 115 losses</em></article>
            <article class="kpi-card"><span>Profit Factor</span><strong id="kpiPf">1.84</strong><em>Gross profit / gross loss</em></article>
            <article class="kpi-card"><span>Max Drawdown</span><strong id="kpiDd">-8.7%</strong><em class="negative">$1,184.30</em></article>
            <article class="kpi-card"><span>Total Trades</span><strong id="kpiTrades">321</strong><em>+18 vs prior period</em></article>
            <article class="kpi-card"><span>Average R</span><strong>+0.42R</strong><em>Risk-adjusted trade result</em></article>
          </div>

          <div class="grid-main">
            <article class="panel widget" data-widget="equity">
              <div class="panel-head">
                <div><span class="panel-kicker">ACCOUNT GROWTH</span><h2>Equity &amp; Balance</h2><p>Track account growth, drawdown and cumulative results.</p></div>
                <div class="chart-tools"><button class="chart-tab active" data-chart="equity">Equity</button><button class="chart-tab" data-chart="balance">Balance</button><button class="chart-tab" data-chart="pnl">P&amp;L</button><button class="chart-tab" data-chart="drawdown">Drawdown</button></div>
              </div>
              <div class="chart-range"><button>1W</button><button class="active">1M</button><button>3M</button><button>6M</button><button>1Y</button><button>ALL</button></div>
              <div class="chart-scroll"><div class="line-chart" id="equityChart" aria-label="Equity curve chart"></div></div>
              <div class="chart-footer"><span>Start <b>$10,000</b></span><span>Current <b>$12,846</b></span><span>Peak <b>$13,112</b></span><span>Drawdown <b class="negative">-8.7%</b></span></div>
            </article>

            <article class="panel widget" data-widget="overview">
              <div class="panel-head"><div><span class="panel-kicker">ACCOUNT</span><h2>Account Overview</h2><p>Source-derived identity and connection state.</p></div><button class="mini-btn" id="accountDetails">Details</button></div>
              <div class="identity-box"><div class="identity-avatar">TA</div><div><b id="overviewName">Primary Trading Account</b><span id="overviewOwner">Demo Workspace</span></div><span class="source-badge">SOURCE STATUS</span></div>
              <div class="overview-grid">
                <div><span>Environment</span><b id="overviewEnv">DEMO</b></div><div><span>Platform</span><b id="overviewPlatform">MetaTrader 5</b></div>
                <div><span>Broker</span><b id="overviewBroker">Example Broker</b></div><div><span>Currency</span><b id="overviewCurrency">USD</b></div>
                <div><span>Account</span><b id="overviewLogin">•••• 4821</b></div><div><span>Leverage</span><b id="overviewLeverage">1:100</b></div>
              </div>
              <div class="connection-note"><span class="status-dot"></span><span id="connectionText">Demo data is being displayed. No live broker connection is active.</span></div>
            </article>
          </div>

          <div class="grid-main">
            <article class="panel widget" data-widget="comparison">
              <div class="panel-head"><div><span class="panel-kicker">HISTORICAL COMPARISON</span><h2>How This Period Compares</h2><p>Make changes visible by comparing the same metrics across periods.</p></div><button class="text-link" data-view="comparisons">Open comparison →</button></div>
              <div class="comparison-table-wrap"><table class="data-table compact"><thead><tr><th>Metric</th><th>Current</th><th>Prior Period</th><th>Change</th><th>Previous Year</th></tr></thead><tbody>
                <tr><td>P&amp;L</td><td>+$2,846</td><td>+$2,318</td><td class="positive">+22.8%</td><td>+$3,104</td></tr>
                <tr><td>Return</td><td>28.46%</td><td>23.18%</td><td class="positive">+5.28 pp</td><td>31.04%</td></tr>
                <tr><td>Win Rate</td><td>64.2%</td><td>61.8%</td><td class="positive">+2.4 pp</td><td>67.1%</td></tr>
                <tr><td>Profit Factor</td><td>1.84</td><td>1.62</td><td class="positive">+0.22</td><td>1.97</td></tr>
                <tr><td>Trades</td><td>321</td><td>303</td><td>+18</td><td>286</td></tr>
                <tr><td>Max Drawdown</td><td>-8.7%</td><td>-7.4%</td><td class="negative">-1.3 pp</td><td>-6.9%</td></tr>
                <tr><td>Avg Holding</td><td>58m</td><td>64m</td><td class="positive">-6m</td><td>52m</td></tr>
              </tbody></table></div>
            </article>
            <article class="panel widget" data-widget="distribution">
              <div class="panel-head"><div><span class="panel-kicker">TRADE DISTRIBUTION</span><h2>Wins vs Losses</h2><p>Understand the shape behind the headline win rate.</p></div></div>
              <div class="distribution">
                <div class="donut" style="--value:64.2"><div><b>64.2%</b><span>Win rate</span></div></div>
                <div class="dist-list"><div><span><i class="dot win"></i>Winning trades</span><b>206</b></div><div><span><i class="dot loss"></i>Losing trades</span><b>115</b></div><div><span>Avg win</span><b>+$126.40</b></div><div><span>Avg loss</span><b>-$74.10</b></div><div><span>Expectancy</span><b>+$24.80</b></div></div>
              </div>
            </article>
          </div>

          <div class="grid-2">
            <article class="panel widget" data-widget="monthly">
              <div class="panel-head"><div><span class="panel-kicker">PERIOD PERFORMANCE</span><h2>Monthly Performance</h2><p>See the pattern across months, not just the latest result.</p></div><button class="text-link" data-view="performance">Open performance →</button></div>
              <div class="bar-chart" id="monthlyChart"></div>
              <div class="mini-table"><div><span>Best month</span><b>Jul 2026 · +$742</b></div><div><span>Lowest month</span><b>Sep 2026 · +$278</b></div></div>
            </article>
            <article class="panel widget" data-widget="symbols">
              <div class="panel-head"><div><span class="panel-kicker">MARKET CONTRIBUTION</span><h2>Symbol Performance</h2><p>Which instruments contributed to the account result?</p></div><button class="text-link" data-view="trades">Drill down →</button></div>
              <div class="rank-list">{symbols.map(([s,pf,profit,wr]) => <div class="rank-row"><span class="rank-name">{s}</span><span class="rank-bar"><i style={`width:${Math.min(100,Math.max(8,pf/700*100))}%`}></i></span><b>+${pf}</b><small>{wr}% win</small></div>)}</div>
            </article>
          </div>

          <div class="grid-2">
            <article class="panel widget" data-widget="sessions">
              <div class="panel-head"><div><span class="panel-kicker">TIME ANALYSIS</span><h2>Sessions &amp; Days</h2><p>Find how performance changes by trading window.</p></div><button class="text-link" data-view="comparisons">Open analysis →</button></div>
              <div class="session-grid">{sessions.map(([name,pf,profit,wr]) => <div class="session-card"><span>{name}</span><b>+${pf}</b><small>PF {profit} · {wr}% win</small></div>)}</div>
              <div class="weekday-row">{weekday.map(([d,p,pf,wr]) => <div><span>{d}</span><i style={`height:${Math.max(18,wr)}%`}></i><b>+${p}</b></div>)}</div>
            </article>
            <article class="panel widget" data-widget="insights">
              <div class="panel-head"><div><span class="panel-kicker">TRADE AVATA INSIGHTS</span><h2>What Matters Now</h2><p>Observations from recorded data, not diagnoses or guarantees.</p></div><button class="text-link" data-view="insights">View all →</button></div>
              <div class="insight-stack">
                <button class="insight-row" data-drill="drawdown"><span>↘</span><div><b>Drawdown is elevated vs the prior period</b><small>Current maximum: 8.7% · prior period: 7.4%</small></div><em>→</em></button>
                <button class="insight-row" data-drill="symbol"><span>◈</span><div><b>XAUUSD accounts for a large share of recent losses</b><small>Recent sample shows higher loss concentration than EURUSD.</small></div><em>→</em></button>
                <button class="insight-row" data-drill="size"><span>↗</span><div><b>Average position size is above your recent baseline</b><small>Review the trade-level size distribution for the selected period.</small></div><em>→</em></button>
              </div>
            </article>
          </div>

          <article class="panel widget" data-widget="recent">
            <div class="panel-head"><div><span class="panel-kicker">EXECUTION</span><h2>Recent Trades</h2><p>Move from a chart to the exact trades that created it.</p></div><button class="text-link" data-view="trades">View all trades →</button></div>
            <div class="table-scroll"><table class="data-table"><thead><tr><th>Date</th><th>Symbol</th><th>Side</th><th>Volume</th><th>Entry</th><th>Exit</th><th>P&amp;L</th><th>Strategy</th><th>Session</th><th>Hold</th></tr></thead><tbody id="recentTradesBody"></tbody></table></div>
          </article>
          </div>
        </section>

        <!-- PERFORMANCE -->
        <section class="ta-view" data-panel="performance">
          <div class="page-heading"><div><span class="eyebrow">PERFORMANCE</span><h1>Performance Analysis</h1><p>Financial performance with period comparisons and drill-downs.</p></div><div class="heading-actions"><button class="ghost-btn" data-export="performance-pdf">⇩ PDF</button><button class="primary-btn" data-export="performance-xlsx">⇩ Spreadsheet</button></div></div>
          <div class="kpi-strip"><article class="kpi-card"><span>Net P&amp;L</span><strong>+$2,846.20</strong><em class="positive">28.46% return</em></article><article class="kpi-card"><span>Gross Profit</span><strong>+$5,940.80</strong><em>247 winning trades gross</em></article><article class="kpi-card"><span>Gross Loss</span><strong>-$3,094.60</strong><em>115 losing trades gross</em></article><article class="kpi-card"><span>Expectancy</span><strong>+$24.80</strong><em>per closed trade</em></article><article class="kpi-card"><span>Avg R</span><strong>+0.42R</strong><em>per trade</em></article></div>
          <article class="panel"><div class="panel-head"><div><span class="panel-kicker">EQUITY / BALANCE</span><h2>Growth Curve</h2><p>Use the horizontal analytical canvas on mobile to preserve readability.</p></div></div><div class="chart-scroll"><div class="line-chart large" id="performanceChart"></div></div></article>
          <div class="grid-2"><article class="panel"><div class="panel-head"><div><span class="panel-kicker">MONTHLY</span><h2>Monthly Results</h2></div></div><div class="comparison-table-wrap"><table class="data-table compact"><thead><tr><th>Month</th><th>P&amp;L</th><th>Return</th><th>PF</th><th>Trades</th><th>Avg R</th></tr></thead><tbody>{monthly.map(m=><tr><td>{m[0]}</td><td class="positive">+${m[1]}</td><td>+{m[2]}%</td><td>{m[3]}</td><td>{m[4]}</td><td>+{m[5]}R</td></tr>)}</tbody></table></div></article><article class="panel"><div class="panel-head"><div><span class="panel-kicker">DRAWDOWN</span><h2>Drawdown Profile</h2></div></div><div class="risk-summary"><div><span>Maximum</span><b class="negative">-8.7%</b><small>$1,184.30</small></div><div><span>Average</span><b>-2.4%</b><small>Across observed periods</small></div><div><span>Recovery</span><b>11 days</b><small>Peak-to-recovery median</small></div></div><div class="risk-meter"><i style="width:43%"></i><span>Current drawdown zone</span></div></article></div>
        </section>

        <!-- TRADES -->
        <section class="ta-view" data-panel="trades">
          <div class="page-heading"><div><span class="eyebrow">TRADE BOOK</span><h1>Trades</h1><p>Search, filter and investigate every recorded execution.</p></div><div class="heading-actions"><button class="ghost-btn" data-export="trades-pdf">⇩ PDF</button><button class="primary-btn" data-export="trades-xlsx">⇩ Spreadsheet</button></div></div>
          <div class="trade-filter-panel"><input id="tradeSearch" placeholder="Search symbol, strategy, session…" /><select id="sideFilter"><option value="">All directions</option><option>BUY</option><option>SELL</option></select><select id="resultFilter"><option value="">All results</option><option value="win">Winners</option><option value="loss">Losers</option></select><select id="strategyFilter"><option value="">All strategies</option><option>Breakout</option><option>Pullback</option><option>Trend</option><option>Reversal</option></select><button class="ghost-btn" id="clearFilters">Clear</button></div>
          <article class="panel"><div class="table-scroll"><table class="data-table trade-table"><thead><tr><th>Date</th><th>Symbol</th><th>Side</th><th>Volume</th><th>Entry</th><th>Exit</th><th>Pips/R</th><th>MAE</th><th>P&amp;L</th><th>Strategy</th><th>Session</th><th>Day</th><th>Hold</th></tr></thead><tbody id="allTradesBody"></tbody></table></div><div class="table-foot"><span id="tradeCount">15 of 321 shown</span><button class="text-link">Load more</button></div></article>
        </section>

        <!-- CALENDAR -->
        <section class="ta-view" data-panel="calendar">
          <div class="page-heading"><div><span class="eyebrow">TIME ANALYSIS</span><h1>Trading Calendar</h1><p>Click a day to move from daily performance into its exact trades.</p></div><div class="heading-actions"><button class="ghost-btn" data-export="calendar-pdf">⇩ PDF</button><button class="primary-btn" data-export="calendar-xlsx">⇩ Spreadsheet</button></div></div>
          <div class="calendar-layout"><article class="panel calendar-panel"><div class="calendar-header"><button class="icon-btn">‹</button><div><span>2026</span><h2>September</h2></div><button class="icon-btn">›</button></div><div class="calendar-grid"><b>Mon</b><b>Tue</b><b>Wed</b><b>Thu</b><b>Fri</b><b>Sat</b><b>Sun</b>{Array.from({length:35},(_,i)=>{const day=i-0; const weekend=i%7>4; const loss=i%9===0; return <button class={`day-cell ${weekend?'muted-day':''} ${loss?'loss-day':'win-day'}`} data-day={day+1}><span>{day+1}</span><b>{weekend?'—':loss?'-$86':i%4===0?'+$182':'+$64'}</b><small>{weekend?'':`${(i%4)+1} trades`}</small></button>})}</div></article><article class="panel day-detail" id="dayDetail"><span class="panel-kicker">DAY DETAIL</span><h2>Select a trading day</h2><p>Choose a date to see its P&amp;L, trades, symbols and sessions.</p></article></div>
        </section>

        <!-- STRATEGIES -->
        <section class="ta-view" data-panel="strategies">
          <div class="page-heading"><div><span class="eyebrow">STRATEGY ANALYTICS</span><h1>Strategies</h1><p>Compare strategy tags when the connected data actually contains them.</p></div><div class="heading-actions"><button class="ghost-btn" data-export="strategies-pdf">⇩ PDF</button><button class="primary-btn" data-export="strategies-xlsx">⇩ Spreadsheet</button></div></div>
          <div class="strategy-cards">{strategies.map(([name,pf,profit,wr,tradesCount,avgR])=><article class="strategy-card"><span>STRATEGY TAG</span><h2>{name}</h2><div class="strategy-metrics"><div><b>+${pf}</b><small>Net P&amp;L</small></div><div><b>{profit}</b><small>Profit factor</small></div><div><b>{wr}%</b><small>Win rate</small></div><div><b>{tradesCount}</b><small>Trades</small></div></div><div class="progress-line"><i style={`width:${wr}%`}></i></div><footer><span>Avg R +{avgR}R</span><button class="text-link">Drill into trades →</button></footer></article>)}</div>
          <div class="grid-2"><article class="panel"><div class="panel-head"><div><span class="panel-kicker">STRATEGY × SYMBOL</span><h2>Where Each Setup Works</h2></div></div><div class="matrix">{strategies.slice(0,3).map(s=><div class="matrix-row"><b>{s[0]}</b><span>EURUSD <em>+${Math.round(s[1]*.35)}</em></span><span>XAUUSD <em>+${Math.round(s[1]*.29)}</em></span><span>GBPUSD <em>+${Math.round(s[1]*.21)}</em></span></div>)}</div></article><article class="panel"><div class="panel-head"><div><span class="panel-kicker">TRADE MANAGEMENT</span><h2>MFE / MAE</h2><p>Maximum favourable/adverse excursion across recorded trades.</p></div></div><div class="mfe-mae"><div><b>+1.72R</b><span>Median MFE</span></div><div><b>-0.46R</b><span>Median MAE</span></div><div><b>68%</b><span>Profit retained</span></div></div></article></div>
        </section>

        <!-- RISK -->
        <section class="ta-view" data-panel="risk">
          <div class="page-heading"><div><span class="eyebrow">RISK ANALYTICS</span><h1>Risk</h1><p>Understand drawdown, exposure, sizing, streaks and risk consistency.</p></div><div class="heading-actions"><button class="ghost-btn" data-export="risk-pdf">⇩ PDF</button><button class="primary-btn" data-export="risk-xlsx">⇩ Spreadsheet</button></div></div>
          <div class="risk-grid"><article class="metric-panel"><span>Maximum Drawdown</span><b class="negative">-8.7%</b><small>$1,184.30 peak-to-trough</small></article><article class="metric-panel"><span>Longest Losing Streak</span><b>6 trades</b><small>Historical maximum</small></article><article class="metric-panel"><span>Average Risk / Trade</span><b>0.82R</b><small>From recorded trade risk</small></article><article class="metric-panel"><span>Largest Loss</span><b class="negative">-$318.50</b><small>Single closed trade</small></article><article class="metric-panel"><span>Largest Win</span><b class="positive">+$482.20</b><small>Single closed trade</small></article><article class="metric-panel"><span>Recovery Time</span><b>11 days</b><small>Median peak recovery</small></article></div>
          <div class="grid-2"><article class="panel"><div class="panel-head"><div><span class="panel-kicker">CONSISTENCY</span><h2>Risk Consistency</h2></div></div><div class="risk-bars">{[['Position size',76],['Risk per trade',68],['Exposure',54],['Loss concentration',43],['R:R consistency',71]].map(([label,value])=><div class="risk-bar"><span>{label}</span><i><b style={`width:${value}%`}></b></i><strong>{value}%</strong></div>)}</div></article><article class="panel"><div class="panel-head"><div><span class="panel-kicker">EXPOSURE</span><h2>Instrument Concentration</h2></div></div><div class="exposure-list">{symbols.map(([s,pf,profit,wr])=><div><span>{s}</span><i><b style={`width:${Math.max(12,profit)}%`}></b></i><strong>{profit}%</strong></div>)}</div></article></div>
        </section>

        <!-- COMPARISONS -->
        <section class="ta-view" data-panel="comparisons">
          <div class="page-heading"><div><span class="eyebrow">CROSS ANALYSIS</span><h1>Comparisons &amp; Drill-down</h1><p>Investigate the same account across periods, symbols, sessions, days and strategies.</p></div><button class="primary-btn" id="resetDrill">Reset drill-down</button></div>
          <div class="drill-path" id="drillPath"><button>All data</button><span>›</span><span>Choose a dimension</span></div>
