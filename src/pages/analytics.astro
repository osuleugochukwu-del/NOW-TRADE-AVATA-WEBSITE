  <script define:vars={{ base, demoAccount, accounts, trades, monthly, symbols, strategies, sessions, weekday, equity }}>
    window.__TRADE_AVATA_ANALYTICS__ = {
      base,
      account: demoAccount,
      accounts,
      trades,
      monthly,
      symbols,
      strategies,
      sessions,
      weekday,
      equity
    };
  </script>
  <script type="module">
    import { watchAuth } from '../lib/firebase/auth.js';
    import { getAnalyticsPreferences, saveAnalyticsPreferences } from '../lib/firebase/analytics.js';

    const DATA = window.__TRADE_AVATA_ANALYTICS__;
    let analyticsUser = null;
    const root = document.documentElement;
    const app = document.getElementById('analyticsApp');
    const views = [...document.querySelectorAll('[data-panel]')];
    const navButtons = [...document.querySelectorAll('[data-view]')];
    const dialogs = [...document.querySelectorAll('dialog')];
    let currentAccount = DATA.account;
    let chartMode = 'equity';
    let latestAIReport = null;

    const $ = (s, scope=document) => scope.querySelector(s);
    const $$ = (s, scope=document) => [...scope.querySelectorAll(s)];
    const money = n => `${n >= 0 ? '+' : '-'}$${Math.abs(Number(n)).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`;

    function show(id, push=true) {
      if(!views.some(v=>v.dataset.panel===id)) id='dashboard';
      views.forEach(v=>v.classList.toggle('active', v.dataset.panel===id));
      navButtons.forEach(b=>b.classList.toggle('active', b.dataset.view===id));
      if(push) history.replaceState(null,'','#'+id);
      window.scrollTo({top:0,behavior:'smooth'});
    }
    navButtons.forEach(b=>b.addEventListener('click',()=>show(b.dataset.view)));
    show(location.hash.replace('#','') || 'dashboard', false);
    window.addEventListener('hashchange',()=>show(location.hash.replace('#','') || 'dashboard',false));

    function openDialog(id){ const d=document.getElementById(id); if(d?.showModal) d.showModal(); else d?.setAttribute('open',''); }
    function closeDialog(d){ if(d?.close) d.close(); else d?.removeAttribute('open'); }
    $$('[data-close-dialog]').forEach(b=>b.addEventListener('click',()=>closeDialog(b.closest('dialog'))));
    dialogs.forEach(d=>d.addEventListener('click',e=>{if(e.target===d) closeDialog(d)}));

    function renderEquity(targetId, values=DATA.equity) {
      const target=document.getElementById(targetId); if(!target) return;
      const w=1100,h=330,p=26;
      const min=Math.min(...values), max=Math.max(...values), range=max-min||1;
      const points=values.map((v,i)=>`${p+i*((w-p*2)/(values.length-1))},${h-p-((v-min)/range)*(h-p*2)}`);
      const area=`${p},${h-p} ${points.join(' ')} ${w-p},${h-p}`;
      const ticks=[0,.25,.5,.75,1].map(t=>`<line x1="${p}" x2="${w-p}" y1="${h-p-t*(h-p*2)}" y2="${h-p-t*(h-p*2)}" class="gridline"/><text x="4" y="${h-p-t*(h-p*2)+4}" class="axis">${Math.round(min+range*t).toLocaleString()}</text>`).join('');
      target.innerHTML=`<svg viewBox="0 0 ${w} ${h}" preserveAspectRatio="none" role="img">${ticks}<polygon points="${area}" class="area"/><polyline points="${points.join(' ')}" class="curve"/>${values.map((v,i)=>i===values.length-1?`<circle cx="${points[i].split(',')[0]}" cy="${points[i].split(',')[1]}" r="5" class="point"/>`:'' ).join('')}</svg>`;
    }

    function renderMonthly() {
      const el=$('#monthlyChart'); if(!el) return;
      const max=Math.max(...DATA.monthly.map(x=>x[1]));
      el.innerHTML=DATA.monthly.map(x=>`<button class="month-bar" data-month="${x[0]}"><span style="height:${Math.max(12,x[1]/max*100)}%"></span><b>${x[1]}</b><small>${x[0].split(' ')[0]}</small></button>`).join('');
      $$('.month-bar',el).forEach(b=>b.addEventListener('click',()=>{ show('comparisons'); setDrill(`Month: ${b.dataset.month}`); }));
    }

    function renderTrades(list=DATA.trades) {
      const row = t => `<tr data-pnl="${t[6]}"><td>${t[0]}</td><td><b>${t[1]}</b></td><td><span class="side ${t[2].toLowerCase()}">${t[2]}</span></td><td>${t[3]}</td><td>${t[4]}</td><td>${t[5]}</td><td>${t[10]}R</td><td>${t[11]}R</td><td class="${t[6]>=0?'positive':'negative'}">${money(t[6])}</td><td>${t[7]}</td><td>${t[8]}</td><td>${t[9]}</td><td>${t[12]}m</td></tr>`;
      $('#recentTradesBody').innerHTML=list.slice(0,5).map(row).join('');
      $('#allTradesBody').innerHTML=list.map(row).join('');
      $('#tradeCount').textContent=`${list.length} of 321 shown`;
    }

    function applyTradeFilters(){
      const q=($('#tradeSearch')?.value||'').trim().toLowerCase();
      const side=$('#sideFilter')?.value||'', result=$('#resultFilter')?.value||'', strategy=$('#strategyFilter')?.value||'';
      const filtered=DATA.trades.filter(t=>{
        const text=t.join(' ').toLowerCase();
        return (!q||text.includes(q))&&(!side||t[2]===side)&&(!strategy||t[7]===strategy)&&(!result||(result==='win'?t[6]>0:t[6]<0));
      });
      renderTrades(filtered);
    }

    function updateAccount(a){
      currentAccount=a;
      const meta=`${a.environment==='UNCONFIRMED'?'ACCOUNT TYPE UNCONFIRMED':a.environment} · ${a.platform} · ${a.currency}`;
      $('#accountName').textContent=a.name; $('#accountMeta').textContent=meta; $('#filterAccount').textContent=a.name.replace(' Account','');
      $('#overviewName').textContent=a.name; $('#overviewOwner').textContent=a.owner;
      $('#overviewEnv').textContent=a.environment==='UNCONFIRMED'?'UNCONFIRMED':a.environment;
      $('#overviewPlatform').textContent=a.platform; $('#overviewBroker').textContent=a.broker; $('#overviewCurrency').textContent=a.currency;
      $('#overviewLogin').textContent=a.login; $('#overviewLeverage').textContent=a.leverage;
      $('#kpiEquity').textContent=`$${a.equity.toLocaleString(undefined,{minimumFractionDigits:2})}`;
      $('#kpiPnl').textContent=money(a.netPnl); $('#kpiWin').textContent=`${(a.wins/a.trades*100).toFixed(1)}%`;
      $('#kpiPf').textContent=a.profitFactor; $('#kpiDd').textContent=`-${a.drawdownPct}%`; $('#kpiTrades').textContent=a.trades;
    }

    $('#accountPicker').addEventListener('click',()=>openDialog('accountDialog'));
    $$('[data-select-account]').forEach(b=>b.addEventListener('click',()=>{
      const a=DATA.accounts.find(x=>x.id===b.dataset.selectAccount);
      if(a){updateAccount(a); closeDialog(b.closest('dialog')); show('dashboard');}
    }));

    function setDrill(label, description='') {
      $('#drillPath').innerHTML=`<button id="drillReset">All data</button><span>›</span><b>${label}</b>`;
      $('#sliceTitle').textContent=label;
      $('#sliceDescription').textContent=description||'This slice is ready for further drill-down into symbols, sessions, days, strategies and individual trades.';
      $('#drillReset').addEventListener('click',()=>resetDrill());
    }
    function resetDrill(){ $('#drillPath').innerHTML='<button id="drillReset">All data</button><span>›</span><span>Choose a dimension</span>'; $('#sliceTitle').textContent='All recorded trades'; $('#sliceDescription').textContent='Start with a dimension above. Every slice can lead back to individual trades.'; $('#drillReset').addEventListener('click',resetDrill); }
    $$('.drill-card').forEach(card=>card.addEventListener('click',()=>{const d=card.dataset.drillDimension; const labels={symbol:'Symbol: EURUSD',session:'Session: London',weekday:'Day: Tuesday',strategy:'Strategy: Breakout',direction:'Direction: BUY',hour:'Hour: 09:00–10:00'}; setDrill(labels[d],`Filtered account data for the selected ${d}. Continue to trades to inspect the exact records.`);}));
    $('#resetDrill').addEventListener('click',resetDrill);

    $$('[data-drill]').forEach(b=>b.addEventListener('click',()=>{const d=b.dataset.drill; show(d==='drawdown'?'risk':'comparisons'); if(d==='symbol') setDrill('Symbol: XAUUSD','Recent XAUUSD results are concentrated in the selected sample.'); if(d==='session') setDrill('Session: London','London shows the highest P&L in the recorded session sample.');}));

    function renderDay(day){
      const d=$('#dayDetail');
      const relevant=DATA.trades.filter(t=>Number(t[0].slice(-2))===Number(day));
      const pnl=relevant.reduce((s,t)=>s+t[6],0);
      d.innerHTML=`<span class="panel-kicker">DAY DETAIL · SEP ${day}, 2026</span><h2>${money(pnl)} P&L</h2><p>${relevant.length||2} recorded trades in this sample.</p><div class="day-stats"><div><span>Win rate</span><b>${relevant.length?Math.round(relevant.filter(t=>t[6]>0).length/relevant.length*100):50}%</b></div><div><span>Trades</span><b>${relevant.length||2}</b></div><div><span>Symbols</span><b>${[...new Set(relevant.map(t=>t[1]))].join(', ')||'EURUSD'}</b></div></div><button class="primary-btn" data-view="trades" id="dayTrades">View day trades →</button>`;
      $('#dayTrades').addEventListener('click',()=>show('trades'));
    }
    $$('.day-cell').forEach(c=>c.addEventListener('click',()=>renderDay(c.dataset.day)));

    $$('.chart-tab').forEach(b=>b.addEventListener('click',()=>{
      $$('.chart-tab').forEach(x=>x.classList.remove('active')); b.classList.add('active'); chartMode=b.dataset.chart;
      const values=chartMode==='drawdown'?DATA.equity.map((v,i)=>-Math.max(0,(Math.max(...DATA.equity.slice(0,i+1))-v)/Math.max(...DATA.equity.slice(0,i+1))*100)):DATA.equity;
      renderEquity('equityChart',values); renderEquity('performanceChart',values);
    }));
    $$('.chart-range button').forEach(b=>b.addEventListener('click',()=>{$$('.chart-range button').forEach(x=>x.classList.remove('active'));b.classList.add('active');}));

    function applyChartTheme(theme){
      const themes={
        blue:{line:'#0878ff',grid:'#17314c'},
        'high-contrast':{line:'#72c8ff',grid:'#365a78'},
        muted:{line:'#7f9db9',grid:'#26384b'}
      };
      const t=themes[theme]||themes.blue;
      app.style.setProperty('--ta-chart-line',t.line); app.style.setProperty('--ta-chart-grid',t.grid);
    }
    const defaultWidgetOrder=['kpis','equity','overview','comparison','distribution','monthly','symbols','sessions','insights','recent'];
    function applyWidgetOrder(order=defaultWidgetOrder){
      const canvas=$('#dashboardCanvas');
      if(!canvas) return;
      order.forEach(id=>{ const w=canvas.querySelector(`[data-widget="${id}"]`); if(w) canvas.appendChild(w); });
    }
    function setupLayout(){
      const saved=JSON.parse(localStorage.getItem('trade-avata-analytics-layout')||'null');
      if(saved?.density) app.dataset.density=saved.density;
      if(saved?.chartHeight) app.dataset.chartHeight=saved.chartHeight;
      if(saved?.accent) app.style.setProperty('--ta-accent',saved.accent);
      if(saved?.background) app.style.setProperty('--ta-bg',saved.background);
      if(saved?.header) app.style.setProperty('--ta-header',saved.header);
      if(saved?.panel) app.style.setProperty('--ta-panel',saved.panel);
      if(saved?.chartTheme) applyChartTheme(saved.chartTheme);
      if(saved?.hidden) saved.hidden.forEach(id=>{ $$(`[data-widget="${id}"]`).forEach(w=>w.classList.add('widget-hidden')); $$(`[data-widget-toggle="${id}"]`).forEach(x=>x.checked=false); });
      applyWidgetOrder(saved?.widgetOrder || defaultWidgetOrder);
    }
    function saveLayout(){
      const hidden=$$('[data-widget-toggle]:not(:checked)').map(x=>x.dataset.widgetToggle);
      const widgetOrder=$$('#widgetList .manager-row').map(row=>row.dataset.widgetId);
      const obj={density:$('#densitySelect').value,chartHeight:$('#chartHeightSelect').value,chartTheme:$('#chartTheme').value,accent:$('#accentColor').value,header:$('#headerColor').value,background:$('#backgroundColor').value,panel:$('#panelColor').value,hidden,widgetOrder};
      localStorage.setItem('trade-avata-analytics-layout',JSON.stringify(obj));
      if (analyticsUser) {
        saveAnalyticsPreferences(analyticsUser.uid,obj).catch(()=>toast('Saved locally. Cloud layout sync is unavailable right now.'));
      }
      setupLayout(); closeDialog($('#customizeDialog')); toast(analyticsUser?'Dashboard layout saved to your workspace.':'Dashboard layout saved on this device.');
    }
    function resetLayout(){ localStorage.removeItem('trade-avata-analytics-layout'); app.dataset.density='comfortable';app.dataset.chartHeight='standard';app.style.removeProperty('--ta-accent');app.style.removeProperty('--ta-bg');app.style.removeProperty('--ta-header');app.style.removeProperty('--ta-panel');app.style.removeProperty('--ta-chart-line');app.style.removeProperty('--ta-chart-grid'); $('#chartTheme').value='blue';$('#accentColor').value='#0878ff';$('#headerColor').value='#07101c';$('#backgroundColor').value='#06101d';$('#panelColor').value='#0b1726';$$('.widget-hidden').forEach(w=>w.classList.remove('widget-hidden'));$$('[data-widget-toggle]').forEach(x=>x.checked=true); applyWidgetOrder(defaultWidgetOrder); $$('#widgetList .manager-row').sort((a,b)=>defaultWidgetOrder.indexOf(a.dataset.widgetId)-defaultWidgetOrder.indexOf(b.dataset.widgetId)).forEach(row=>$('#widgetList').appendChild(row)); toast('Trade Avata Default restored.'); }
    $('#customizeBtn').addEventListener('click',()=>openDialog('customizeDialog'));
    $$('[data-open-customize]').forEach(b=>b.addEventListener('click',()=>openDialog('customizeDialog')));
    $('#saveLayout').addEventListener('click',saveLayout); $('#resetLayout').addEventListener('click',resetLayout);
    $('#densitySelect').addEventListener('change',e=>app.dataset.density=e.target.value);
    $('#chartHeightSelect').addEventListener('change',e=>app.dataset.chartHeight=e.target.value);
    $('#accentColor').addEventListener('input',e=>app.style.setProperty('--ta-accent',e.target.value));
    $('#headerColor').addEventListener('input',e=>app.style.setProperty('--ta-header',e.target.value));
    $('#backgroundColor').addEventListener('input',e=>app.style.setProperty('--ta-bg',e.target.value));
    $('#panelColor').addEventListener('input',e=>app.style.setProperty('--ta-panel',e.target.value));
    $('#chartTheme').addEventListener('change',e=>applyChartTheme(e.target.value));
    $$('[data-widget-toggle]').forEach(input=>input.addEventListener('change',()=>{const w=$(`[data-widget="${input.dataset.widgetToggle}"]`);w?.classList.toggle('widget-hidden',!input.checked)}));
    $$('.preset').forEach(p=>p.addEventListener('click',()=>{ $$('.preset').forEach(x=>x.classList.remove('active'));p.classList.add('active'); const presets={balanced:['comfortable','standard'],performance:['spacious','tall'],active:['compact','standard'],risk:['comfortable','tall']}; const [d,h]=presets[p.dataset.preset]; $('#densitySelect').value=d;$('#chartHeightSelect').value=h;app.dataset.density=d;app.dataset.chartHeight=h;}));
    setupLayout();
    watchAuth(async user => {
      analyticsUser = user;
      if (!user) return;
      try {
        const prefs = await getAnalyticsPreferences(user.uid);
        if (!prefs) return;
        localStorage.setItem('trade-avata-analytics-layout',JSON.stringify(prefs));
        setupLayout();
        if (prefs.density) $('#densitySelect').value=prefs.density;
        if (prefs.chartHeight) $('#chartHeightSelect').value=prefs.chartHeight;
        if (prefs.accent) { $('#accentColor').value=prefs.accent; app.style.setProperty('--ta-accent',prefs.accent); }
        if (prefs.header) { $('#headerColor').value=prefs.header; app.style.setProperty('--ta-header',prefs.header); }
        if (prefs.background) { $('#backgroundColor').value=prefs.background; app.style.setProperty('--ta-bg',prefs.background); }
        if (prefs.panel) { $('#panelColor').value=prefs.panel; app.style.setProperty('--ta-panel',prefs.panel); }
        if (prefs.chartTheme) { $('#chartTheme').value=prefs.chartTheme; applyChartTheme(prefs.chartTheme); }
      } catch {}
    });

    // Basic drag reorder for dashboard widgets. We only reorder within the main dashboard flow.
    let dragged=null;
    $$('#widgetList .manager-row').forEach(row=>row.addEventListener('dragstart',()=>{dragged=row}));
    $$('#widgetList .manager-row').forEach(row=>row.addEventListener('dragover',e=>e.preventDefault()));
    $$('#widgetList .manager-row').forEach(row=>row.addEventListener('drop',()=>{if(dragged&&dragged!==row){row.parentNode.insertBefore(dragged,row); const order=$$('#widgetList .manager-row').map(x=>x.dataset.widgetId); applyWidgetOrder(order); toast('Widget order updated. Save dashboard to keep it.')}}));

    function toast(message){let t=$('.ta-toast');if(!t){t=document.createElement('div');t.className='ta-toast';document.body.appendChild(t)}t.textContent=message;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2200)}

    // Connect flow deliberately does not ask the user to label REAL/DEMO.
    $('#connectBtn').addEventListener('click',()=>openDialog('connectDialog'));
    $('#connectAccount2').addEventListener('click',()=>openDialog('connectDialog'));
    $('#startConnection').addEventListener('click',()=>{
      const status=$('#connectStatus'); status.hidden=false; status.innerHTML='<b>Provider connection is not configured in this static build.</b><span>Choose a supported provider in the production connector layer. No credentials are collected by this page.</span>'; toast('Connection adapter required for live account sync.');
    });
    $('#syncBtn').addEventListener('click',()=>toast('No live provider is connected. Demo workspace remains unchanged.'));
    $('#accountDetails').addEventListener('click',()=>{ $('#infoTitle').textContent='Account source details'; $('#infoBody').textContent='In production, these fields are populated from the authenticated broker/platform connection. User-entered environment labels are not trusted as verification.'; openDialog('infoDialog'); });

    $('#mobileMenu').addEventListener('click',()=>document.body.classList.toggle('nav-open'));
    $('#topMore').addEventListener('click',()=>openDialog('customizeDialog'));
    $('#periodBtn').addEventListener('click',()=>toast('Period selector ready for account-data filtering.'));
    $('#filterMore').addEventListener('click',()=>toast('Advanced filters: day, hour, session, result, risk, holding time and tags.'));
    $('#clearFilters').addEventListener('click',()=>{$('#tradeSearch').value='';$('#sideFilter').value='';$('#resultFilter').value='';$('#strategyFilter').value='';applyTradeFilters()});
    ['tradeSearch','sideFilter','resultFilter','strategyFilter'].forEach(id=>document.getElementById(id)?.addEventListener('input',applyTradeFilters));
    $('#shareBtn').addEventListener('click',()=>{const v=$('#shareVisibility').value; $('#infoTitle').textContent='Share portfolio'; $('#infoBody').textContent=`${v} sharing will create a controlled view. The shared page will use source-derived authenticity status and will never expose broker credentials.`;openDialog('infoDialog')});
    $('#generateReport').addEventListener('click',()=>{show('downloads');toast('Report workspace opened. Choose PDF or XLSX for the report you want.')});
    $('#addLedger').addEventListener('click',()=>{ $('#infoTitle').textContent='Add bookkeeping record'; $('#infoBody').textContent='The ledger UI is ready for deposits, withdrawals, fees, swaps and adjustments. Production writes will use the authenticated account backend.';openDialog('infoDialog')});


    function renderAIReport(report, mode='evidence'){
      latestAIReport=report;
      const findings=$('#aiFindings');
      if(!findings) return;
      $('#aiReportIntro').textContent=report.summary;
      $('#aiModeLabel').textContent=mode==='provider'?'AI provider connected':'Evidence engine ready';
      $('#aiModeDetail').textContent=mode==='provider'?'Narrative generated from Trade Avata evidence payload':'Local evidence analysis · connect a trusted AI endpoint for generative explanations';
      findings.innerHTML=`<div class="ai-summary-box"><span>PRIMARY INVESTIGATION</span><h3>${report.headline}</h3><p>${report.summary}</p></div>${report.findings.map((f,i)=>`<article class="ai-finding"><div class="ai-finding-top"><span class="ai-level ${f.levelClass}">${f.level}</span><b>${String(i+1).padStart(2,'0')}</b></div><h3>${f.title}</h3><p>${f.detail}</p><div class="ai-evidence"><span>Evidence</span><b>${f.evidence}</b></div><button class="text-link" data-ai-drill="${f.drill}">Inspect supporting data →</button></article>`).join('')}<div class="ai-next-step"><b>Next investigation</b><span>${report.nextStep}</span></div>`;
      $$('[data-ai-drill]').forEach(b=>b.addEventListener('click',()=>{const d=b.dataset.aiDrill; show(d==='risk'?'risk':d==='trades'?'trades':d==='comparisons'?'comparisons':'risk');}));
    }

    async function runAIAnalysis(){
      const evidence=buildAIAnalyticsEvidence({account:currentAccount,trades:DATA.trades,monthly:DATA.monthly,strategies:DATA.strategies,sessions:DATA.sessions,weekday:DATA.weekday});
      const localReport=evidence.report;
      renderAIReport(localReport,'evidence');
      toast('Trade Avata AI Analytics completed the evidence review.');
      try{
        const response=await requestAIAnalytics(getAIAnalyticsPrompt(evidence));
        if(response?.report) renderAIReport(response.report,'provider');
      }catch{}
    }
    $('#runAIAnalysis')?.addEventListener('click',runAIAnalysis);
    $('#runAIAnalysis2')?.addEventListener('click',runAIAnalysis);
    $('#aiScopeBtn')?.addEventListener('click',()=>{ $('#infoTitle').textContent='AI Analytics data scope'; $('#infoBody').textContent='The investigation uses the selected account, recorded trades, P&L, drawdown, position-size proxies, strategy/session dimensions and available bookkeeping/rule data. AI receives structured evidence rather than broker credentials. Challenge-specific conclusions require the applicable challenge rules.'; openDialog('infoDialog'); });
    $$('.ai-investigation-card').forEach(card=>card.addEventListener('click',()=>{show('ai-analytics');runAIAnalysis();toast(`${card.querySelector('b')?.textContent||'Investigation'} started.`)}));

    async function exportXlsx(kind){
      let XLSX;
      try { XLSX=await import('https://cdn.sheetjs.com/xlsx-0.20.3/package/xlsx.mjs'); }
      catch(e){ csvFallback(kind); toast('XLSX library unavailable; CSV fallback downloaded.'); return; }
      const wb=XLSX.utils.book_new();
      const add=(name,rows)=>{const ws=XLSX.utils.aoa_to_sheet(rows);ws['!cols']=rows[0].map((_,i)=>({wch:Math.min(28,Math.max(12,...rows.map(r=>String(r[i]??'').length)+2))}));XLSX.utils.book_append_sheet(wb,ws,name.slice(0,31));};
      add('Summary',[['Trade Avata Analytics','Value'],['Account',currentAccount.name],['Environment',currentAccount.environment],['Platform',currentAccount.platform],['Broker',currentAccount.broker],['Currency',currentAccount.currency],['Equity',currentAccount.equity],['Net P&L',currentAccount.netPnl],['Return %',currentAccount.returnPct],['Win Rate %',currentAccount.wins/currentAccount.trades*100],['Profit Factor',currentAccount.profitFactor],['Max Drawdown %',-currentAccount.drawdownPct],['Trades',currentAccount.trades]]);
      if(kind.includes('trades')||kind==='complete') add('Trades',[['Date','Symbol','Side','Volume','Entry','Exit','R','MAE','P&L','Strategy','Session','Day','Hold Minutes'],...DATA.trades]);
      if(kind.includes('performance')||kind==='complete') add('Monthly Performance',[['Month','P&L','Return %','Profit Factor','Trades','Avg R'],...DATA.monthly]);
      if(kind.includes('strategies')||kind==='complete') add('Strategies',[['Strategy','P&L','Profit Factor','Win Rate %','Trades','Avg R'],...DATA.strategies]);
      if(kind.includes('risk')||kind==='complete') add('Risk',[['Metric','Value'],['Max Drawdown %',-currentAccount.drawdownPct],['Longest Losing Streak',6],['Average Risk / Trade R',currentAccount.avgR],['Largest Loss',-318.50],['Largest Win',482.20],['Recovery Days',11]]);
      if(kind.includes('calendar')||kind==='complete') add('Calendar',[['Date','P&L','Trades'],...Array.from({length:30},(_,i)=>[`2026-09-${String(i+1).padStart(2,'0')}`,i%9===0?-86:i%4===0?182:64,(i%4)+1])]);
      if(kind.includes('bookkeeping')||kind==='complete') add('Ledger',[['Date','Type','Description','Amount'],['2026-07-01','Deposit','Initial funding',10000],['2026-09-28','Trading P&L','Closed trades',3094.60],['2026-09-28','Fees','Commissions + swaps',-248.40]]);
      if(kind.includes('ai-analytics')||kind==='complete') add('AI Analytics',[['Finding','Level','Evidence'],...(latestAIReport?.findings||[]).map(f=>[f.title,f.level,f.evidence])]);
      if(kind.includes('insights')||kind==='complete') add('Insights',[['Observation','Detail'],['Period comparison','Current P&L is above the prior period.'],['Symbol concentration','EURUSD and XAUUSD contribute a large share of sample P&L.'],['Session','London is strongest in this sample.'],['Risk','Maximum drawdown is 8.7%.']]);
      XLSX.writeFile(wb,`trade-avata-${kind}-report.xlsx`,{compression:true});
      toast('XLSX report prepared.');
    }
    function csvFallback(kind){const rows=[['Trade Avata Analytics','Value'],['Account',currentAccount.name],['Net P&L',currentAccount.netPnl],['Equity',currentAccount.equity],['Trades',currentAccount.trades]];const csv=rows.map(r=>r.map(v=>`"${String(v).replaceAll('"','""')}"`).join(',')).join('\\n');const blob=new Blob([csv],{type:'text/csv'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`trade-avata-${kind}.csv`;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
    function exportPdf(kind){
      const w=window.open('','_blank','width=980,height=800'); if(!w){toast('Allow pop-ups to create the PDF.');return}
      w.document.write(`<html><head><title>Trade Avata — ${kind}</title><style>body{font-family:Arial,sans-serif;padding:38px;color:#0b1728}h1{font-size:28px}h2{margin-top:28px;font-size:17px}.meta{color:#526173;font-size:12px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.box{border:1px solid #d8e1ec;border-radius:10px;padding:14px;margin:8px 0}table{width:100%;border-collapse:collapse}td,th{padding:8px;border-bottom:1px solid #e1e7ef;text-align:left;font-size:11px}</style></head><body><h1>Trade Avata — ${kind.replaceAll('-',' ')}</h1><div class="meta">Generated ${new Date().toLocaleString()} · ${currentAccount.name} · ${currentAccount.platform}</div><div class="grid"><div class="box"><b>Equity</b><br>$${currentAccount.equity.toLocaleString()}</div><div class="box"><b>Net P&L</b><br>${money(currentAccount.netPnl)}</div><div class="box"><b>Win Rate</b><br>${(currentAccount.wins/currentAccount.trades*100).toFixed(1)}%</div></div><h2>Report scope</h2><p>This report contains the selected Trade Avata analytics scope. Production values are populated from the authenticated account data source.</p><h2>Key metrics</h2><table><tr><th>Metric</th><th>Value</th></tr><tr><td>Profit Factor</td><td>${currentAccount.profitFactor}</td></tr><tr><td>Max Drawdown</td><td>-${currentAccount.drawdownPct}%</td></tr><tr><td>Trades</td><td>${currentAccount.trades}</td></tr><tr><td>Average R</td><td>+${currentAccount.avgR}R</td></tr></table><script>window.onload=()=>setTimeout(()=>window.print(),250)<\/script></body></html>`);w.document.close()
    }
    $$('[data-export]').forEach(b=>b.addEventListener('click',()=>{const kind=b.dataset.export;if(kind.endsWith('-xlsx'))exportXlsx(kind.replace('-xlsx',''));else exportPdf(kind.replace('-pdf',''))}));

    renderEquity('equityChart'); renderEquity('performanceChart'); renderMonthly(); renderTrades(); applyTradeFilters(); resetDrill();
  </script>
</body>
</html>