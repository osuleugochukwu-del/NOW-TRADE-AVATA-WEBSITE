---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Create account — Trade Avata" description="Create a Trade Avata member account.">
  <section class="section"><div class="shell" style="max-width:560px"><span class="eyebrow">GET STARTED</span><h1 class="page-title">Create your account</h1><p class="lead">Start your Trade Avata journey and keep your profile, journal and trading workspace together.</p><form id="registerForm" class="card" style="margin-top:28px;display:grid;gap:14px"><label>Name<input name="name" autocomplete="name" required /></label><label>Email<input name="email" type="email" autocomplete="email" required /></label><label>Password<input name="password" type="password" minlength="6" autocomplete="new-password" required /></label><button class="button" type="submit">Create account</button><p id="registerStatus" class="lead" style="font-size:14px;margin:0"></p><a class="text-link" href="/login/">Already have an account? Sign in →</a></form></div></section>
<script>
import { createUserWithEmailAndPassword, updateProfile } from 'firebase/auth';
import { auth } from '../../lib/firebase/auth.js';
import { ensureUserProfile } from '../../lib/firebase/db.js';
const form=document.querySelector('#registerForm'); const status=document.querySelector('#registerStatus');
form?.addEventListener('submit',async e=>{e.preventDefault(); if(!auth){status.textContent='Firebase authentication is not configured yet.';return;} const f=new FormData(form); status.textContent='Creating account…'; try{const cred=await createUserWithEmailAndPassword(auth,String(f.get('email')),String(f.get('password'))); await updateProfile(cred.user,{displayName:String(f.get('name')||'').trim()}); await ensureUserProfile(cred.user); location.href='/';}catch(err){status.textContent=err?.message||'Account creation failed.';}});
</script>
</BaseLayout>
