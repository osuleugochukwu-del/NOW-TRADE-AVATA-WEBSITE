---
import PrivateAppLayout from '../../../layouts/PrivateAppLayout.astro'; import PrivateCopyGate from '../../../components/PrivateCopyGate.astro';
---
<PrivateAppLayout title="Copy Trading — Copier"><PrivateCopyGate /><main class="workspace"><header><a href="/copy-trading/">← Copy Trading</a><span>COPIER WORKSPACE</span></header><section><h1>Copier Account</h1><p>Connect an eligible trading account, choose a provider, and control copying risk.</p><div class="cards"><article><span>Status</span><b>Private testing</b></article><article><span>Provider fee</span><b>Configurable</b></article><article><span>Risk model</span><b>Configurable</b></article></div><form id="masterForm"><label>Provider to follow<input name="name" placeholder="Provider ID or strategy"/></label><label>Copy allocation<input name="fee" type="number" min="0" step="0.01" placeholder="0"/></label><label>Risk multiplier<input name="allocation" type="number" min="0" step="0.01" placeholder="10000"/></label><button>Save copier configuration</button></form></section></main></PrivateAppLayout>
<style is:global>.workspace{max-width:1050px;margin:auto;padding:28px}.workspace header{display:flex;justify-content:space-between;color:var(--app-muted)}.workspace section{padding:70px 0}.workspace h1{font-size:48px}.workspace p{color:var(--app-muted);line-height:1.6}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:30px 0}.cards article,form{border:1px solid var(--app-border);background:var(--app-panel);border-radius:16px;padding:20px}.cards span{display:block;color:var(--app-muted);font-size:12px}.cards b{display:block;margin-top:8px}.workspace form{display:grid;gap:15px}.workspace label{display:grid;gap:8px;color:var(--app-muted);font-size:13px}.workspace input{padding:12px;border:1px solid var(--app-border);border-radius:10px;background:var(--app-panel2);color:var(--app-text)}.workspace button{padding:12px;border:0;border-radius:10px;background:var(--app-accent);color:white}@media(max-width:650px){.cards{grid-template-columns:1fr}.workspace h1{font-size:38px}}
</style>
