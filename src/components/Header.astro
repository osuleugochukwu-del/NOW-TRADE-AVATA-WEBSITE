---
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label="Trade Avata home">
      <img class="brand-lockup" data-brand-logo src={`${base}brand/trade-avata-logo.svg`} alt="Trade Avata — Trade Simple" />
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={`${base}learn/`}>Learn</a>
      <a href={`${base}trade/`}>Trade</a>
      <a href={`${base}tools/`}>Tools</a>
      <a href={`${base}market/`}>Market</a>
      <a href={`${base}store/`}>Store</a>
      <a href={`${base}about/`}>About</a>
    </nav>
    <div class="header-actions">
      <a class="text-link" href={`${base}login/`}>Login</a>
      <a class="button button-small" href={`${base}register/`}>Get Started</a>
      <button class="theme-button" type="button" data-theme-toggle aria-label="Switch to light theme" title="Switch to light theme"><span data-theme-icon aria-hidden="true">☀</span></button>
      <button class="menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">☰</button>
    </div>
  </div>
  <div id="mobile-nav" class="mobile-nav" hidden>
    <div class="shell mobile-nav-inner">
      <a href={`${base}learn/`}>Learn</a><a href={`${base}trade/`}>Trade</a><a href={`${base}tools/`}>Tools</a><a href={`${base}market/`}>Market</a><a href={`${base}store/`}>Store</a><a href={`${base}about/`}>About</a>
      <div class="mobile-actions"><a href={`${base}login/`}>Login</a><a class="button" href={`${base}register/`}>Get Started</a></div>
    </div>
  </div>
</header>
<script is:inline>
  const toggle = document.querySelector('[data-theme-toggle]');
  const icon = document.querySelector('[data-theme-icon]');
  const logo = document.querySelector('[data-brand-logo]');
  const menu = document.querySelector('[data-menu-toggle]');
  const mobile = document.querySelector('#mobile-nav');
  const applyTheme = (theme) => {
    document.documentElement.dataset.theme = theme;
    const light = theme === 'light';
    if (icon) icon.textContent = light ? '☾' : '☀';
    if (toggle) {
      toggle.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      toggle.setAttribute('title', light ? 'Switch to dark theme' : 'Switch to light theme');
    }
    if (logo) logo.src = `${base}brand/trade-avata-logo${light ? '-light' : ''}.svg`;
  };
  let saved = null;
  try { saved = localStorage.getItem('ta-theme'); } catch {}
  applyTheme(saved === 'light' ? 'light' : 'dark');
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    applyTheme(next);
    try { localStorage.setItem('ta-theme', next); } catch {}
  });
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') === 'true';
    menu.setAttribute('aria-expanded', String(!open));
    mobile.hidden = open;
  });
</script>
