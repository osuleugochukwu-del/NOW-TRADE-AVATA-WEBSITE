<button class="support-chat-launcher" type="button" data-support-open aria-label="Chat with Trade Avata">💬 <span>Chat with us</span></button>
<div class="support-chat" data-support-chat hidden>
  <div class="support-chat__head"><div><strong>Trade Avata Support</strong><small>Ask us a question</small></div><button type="button" data-support-close aria-label="Close chat">×</button></div>
  <div class="support-chat__messages" data-support-messages aria-live="polite"><div class="support-chat__empty">Hi 👋 How can we help you?</div></div>
  <form class="support-chat__form" data-support-form><input name="message" maxlength="2000" autocomplete="off" placeholder="Type your message…" required /><button type="submit" aria-label="Send message">➤</button></form>
  <div class="support-chat__note">Please don't send passwords, API keys or sensitive account credentials.</div>
</div>
<style>
.support-chat-launcher{position:fixed;right:18px;bottom:18px;z-index:80;border:0;border-radius:999px;padding:.75rem 1rem;background:#0b73ff;color:#fff;font-weight:700;box-shadow:0 12px 30px #0004;cursor:pointer}.support-chat{position:fixed;right:18px;bottom:78px;width:min(360px,calc(100vw - 24px));height:min(520px,calc(100vh - 110px));z-index:81;background:#071426;border:1px solid #24415f;border-radius:18px;overflow:hidden;box-shadow:0 24px 60px #0007;display:flex;flex-direction:column;color:#edf6ff}.support-chat__head{padding:14px 16px;border-bottom:1px solid #24415f;display:flex;justify-content:space-between;align-items:center}.support-chat__head small{display:block;color:#9db2c9;margin-top:3px}.support-chat__head button{background:none;border:0;color:inherit;font-size:24px;cursor:pointer}.support-chat__messages{flex:1;overflow:auto;padding:14px;display:flex;flex-direction:column;gap:8px}.support-chat__empty{color:#9db2c9;text-align:center;margin:auto}.support-message{max-width:84%;padding:9px 11px;border-radius:12px;white-space:pre-wrap;overflow-wrap:anywhere}.support-message.visitor{align-self:flex-end;background:#0b73ff}.support-message.admin{align-self:flex-start;background:#10253d}.support-chat__form{display:flex;gap:8px;padding:10px;border-top:1px solid #24415f}.support-chat__form input{min-width:0;flex:1;border:1px solid #35516e;background:#091b2e;color:#fff;border-radius:10px;padding:10px}.support-chat__form button{width:42px;border:0;border-radius:10px;background:#0b73ff;color:#fff}.support-chat__note{font-size:10px;color:#8095aa;padding:0 12px 10px}.support-chat[hidden]{display:none}@media(max-width:520px){.support-chat-launcher span{display:none}.support-chat-launcher{padding:.8rem}.support-chat{right:12px;bottom:70px;width:calc(100vw - 24px)}}
</style>
<script>
let support=null; const launcher=document.querySelector('[data-support-open]'); const panel=document.querySelector('[data-support-chat]'); const close=document.querySelector('[data-support-close]'); const form=document.querySelector('[data-support-form]'); const list=document.querySelector('[data-support-messages]'); let visitor=null; let conversation=null; let stop=null;
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
function render(items){list.innerHTML=items.length?items.map(m=>`<div class="support-message ${m.senderType==='admin'?'admin':'visitor'}">${esc(m.message)}</div>`).join(''):'<div class="support-chat__empty">Hi 👋 How can we help you?</div>';list.scrollTop=list.scrollHeight;}
async function open(){panel.hidden=false;try{support ||= await import('../lib/firebase/support.js'); visitor=await support.ensureSupportVisitor();conversation=await support.getSupportConversation(visitor.uid);if(conversation){if(stop)stop();stop=support.watchSupportMessages(conversation.id,render);}}catch(e){list.innerHTML='<div class="support-chat__empty">Support chat is temporarily unavailable.</div>';}}
launcher?.addEventListener('click',open);close?.addEventListener('click',()=>panel.hidden=true);
form?.addEventListener('submit',async e=>{e.preventDefault();const input=form.message;const message=input.value.trim();if(!message)return;input.value='';try{support ||= await import('../lib/firebase/support.js');if(!visitor)visitor=await support.ensureSupportVisitor();if(!conversation){const id=await support.createSupportConversation(visitor.uid,message);conversation={id,visitorUid:visitor.uid};if(stop)stop();stop=support.watchSupportMessages(conversation.id,render);}else await support.sendSupportMessage(conversation.id,'visitor',visitor.uid,message);}catch(err){input.value=message;}});
</script>
